{
	"name": "PL5_RESTAPI_ADLSPARQUET_DELETION",
	"properties": {
		"description": "We used Rest API Data https://retoolapi.dev/5yDVOt/data\n as an input and copied the data to ADLS in Parquet format. Later we deleted the file using Delete activity Activity Used: Copy Data, Delete",
		"activities": [
			{
				"name": "CPY_RESTAPI_ADLS_DELETE",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false
				}
			},
			{
				"name": "DELETE_PARQUET",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "CPY_RESTAPI_ADLS_DELETE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"wildcardFileName": "*.parquet",
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-03-11T08:20:58Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}