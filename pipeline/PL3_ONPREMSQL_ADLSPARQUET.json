{
	"name": "PL3_ONPREMSQL_ADLSPARQUET",
	"properties": {
		"description": "We used On Prem SQL person.person table  as an input and copied the data to ADLS in Parquet format. Activity Used: Copy Data using Self Hosted Integration Runtime.\n",
		"activities": [
			{
				"name": "CPY_SQL_PARQUET",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS3_SQL_TABLE_INPUT",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS3_ADLS_PARQUET_INPUT",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-03-11T07:07:03Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}